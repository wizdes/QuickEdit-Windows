<?xml version="1.0" encoding="utf-8"?>
<!--
  The package manifest for QuickEdit. packaging/README.md gives the source of each choice.

  FILL IN AFTER RESERVING THE NAME IN PARTNER CENTER. These 3 values are the only placeholders:
    Identity Name               PLACEHOLDER.QuickEdit
    Identity Publisher          CN=PLACEHOLDER
    PublisherDisplayName        PLACEHOLDER

  The version here is the only copy that packaging/build.ps1 reads.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 desktop rescap">

  <Identity
    Name="PLACEHOLDER.QuickEdit"
    Publisher="CN=PLACEHOLDER"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>QuickEdit</DisplayName>
    <PublisherDisplayName>PLACEHOLDER</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
      Id="QuickEdit"
      Executable="QuickEdit.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="QuickEdit"
        Description="A fast plain-text editor for Windows 11 that opens, edits and saves plain text."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="QuickEdit.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="quickedit.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="plaintext" Parameters="&quot;%1&quot;" MultiSelectModel="Document">
            <uap:DisplayName>Plain text</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <!-- packaging/README.md holds the same list, and a test compares them. -->
              <uap:FileType>.txt</uap:FileType>
              <uap:FileType>.text</uap:FileType>
              <uap:FileType>.log</uap:FileType>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.json</uap:FileType>
              <uap:FileType>.jsonc</uap:FileType>
              <uap:FileType>.csv</uap:FileType>
              <uap:FileType>.tsv</uap:FileType>
              <uap:FileType>.yaml</uap:FileType>
              <uap:FileType>.yml</uap:FileType>
              <uap:FileType>.toml</uap:FileType>
              <uap:FileType>.ini</uap:FileType>
              <uap:FileType>.cfg</uap:FileType>
              <uap:FileType>.conf</uap:FileType>
              <uap:FileType>.diff</uap:FileType>
              <uap:FileType>.patch</uap:FileType>
              <uap:FileType>.rst</uap:FileType>
              <uap:FileType>.tex</uap:FileType>
              <uap:FileType>.c</uap:FileType>
              <uap:FileType>.h</uap:FileType>
              <uap:FileType>.cc</uap:FileType>
              <uap:FileType>.cpp</uap:FileType>
              <uap:FileType>.hpp</uap:FileType>
              <uap:FileType>.cs</uap:FileType>
              <uap:FileType>.css</uap:FileType>
              <uap:FileType>.go</uap:FileType>
              <uap:FileType>.java</uap:FileType>
              <uap:FileType>.jsx</uap:FileType>
              <uap:FileType>.kt</uap:FileType>
              <uap:FileType>.lua</uap:FileType>
              <uap:FileType>.rs</uap:FileType>
              <uap:FileType>.sh</uap:FileType>
              <uap:FileType>.sql</uap:FileType>
              <uap:FileType>.swift</uap:FileType>
              <uap:FileType>.tsx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
